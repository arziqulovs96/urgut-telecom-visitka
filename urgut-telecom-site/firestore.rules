rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }

    // Sayt matnlari va sozlamalari: hamma o‘qiydi, faqat admin yozadi
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Do‘kon mahsulotlari va chiroyli raqamlar: hamma ko‘radi
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /numbers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Yangiliklar: chop etilganini hamma ko‘radi, qoralamalarni faqat admin
    match /news/{id} {
      allow read: if isAdmin() || resource.data['status'] == 'published';
      allow write: if isAdmin();
    }

    // Mijoz baholari: tasdiqlanganini hamma ko‘radi
    match /reviews/{id} {
      allow read: if isAdmin() || resource.data['status'] == 'approved';
      allow write: if isAdmin();
    }

    // Promokodlar faqat adminga ko‘rinadi (tekshirish server orqali)
    match /promos/{id} {
      allow read, write: if isAdmin();
    }

    // Arizalar faqat server (Netlify) orqali yaratiladi
    match /requests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // AI boshqaruv jurnali
    match /ailog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Telegram bot adminlari va foydalanuvchilari (bot server orqali yozadi)
    match /botAdmins/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /botUsers/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Adminlar ro‘yxati: faqat Firebase Console’dan qo‘shiladi
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
